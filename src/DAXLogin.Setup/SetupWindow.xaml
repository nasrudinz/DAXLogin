<Window x:Class="DAXLogin.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAXLogin Setup" Width="452" Height="632" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        FontFamily="Segoe UI, Leelawadee UI" FontSize="13.5" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#1B1D21"/>
        <SolidColorBrush x:Key="Text2" Color="#6B7280"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Line" Color="#E2E5EA"/>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Accent}"/>
                            <Border x:Name="Ov" CornerRadius="10" Background="Black" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ov" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ov" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- buttons that sit on the coloured header -->
        <Style x:Key="OnHero" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#26FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Option" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" Padding="14,11" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="White"
                                        BorderBrush="#B6BDC9" BorderThickness="1.5">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F3F5F8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EAF0FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="16" Background="#F5F6F8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="232"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border CornerRadius="16,16,0,0" MouseLeftButtonDown="Hero_MouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#4338CA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ClipToBounds="True">
                    <Grid.Clip>
                        <!-- rounds only the top corners: the rect extends past the bottom edge -->
                        <RectangleGeometry Rect="0,0,416,264" RadiusX="16" RadiusY="16"/>
                    </Grid.Clip>
                    <Ellipse Width="260" Height="260" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-120,-90,0" IsHitTestVisible="False"/>
                    <Ellipse Width="180" Height="180" Fill="#0FFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-70,0,0,-90" IsHitTestVisible="False"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                        <Button x:Name="LangBtn" Style="{StaticResource OnHero}" Click="Lang_Click" FontSize="12"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource OnHero}" Click="Close_Click" Margin="6,0,0,0"
                                FontFamily="{StaticResource IconFont}" FontSize="10" Content="&#xE8BB;"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0" IsHitTestVisible="False">
                        <Border Width="76" Height="76" CornerRadius="18" Background="White" HorizontalAlignment="Center">
                            <Canvas Width="76" Height="76">
                                <Ellipse Canvas.Left="15" Canvas.Top="15" Width="24" Height="24"
                                         Stroke="{StaticResource Accent}" StrokeThickness="6.5"/>
                                <Line X1="35.5" Y1="35.5" X2="59" Y2="59" Stroke="{StaticResource Accent}" StrokeThickness="6.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="50" Y1="50" X2="57.5" Y2="42.5" Stroke="{StaticResource Accent}" StrokeThickness="6.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="58" Y1="58" X2="64" Y2="52" Stroke="{StaticResource Accent}" StrokeThickness="6.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                        <TextBlock Text="DAXLogin" Foreground="White" FontSize="27" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="Tagline" Foreground="#DDE6FF" FontSize="13.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- step 1: options -->
            <Grid x:Name="OptionsPanel" Grid.Row="1" Margin="22,20,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="4">
                    <StackPanel>
                        <CheckBox x:Name="DesktopBox" Style="{StaticResource Option}" IsChecked="True"/>
                        <CheckBox x:Name="StartMenuBox" Style="{StaticResource Option}" IsChecked="True"/>
                        <CheckBox x:Name="StartupBox" Style="{StaticResource Option}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NoAdmin" Grid.Row="1" Foreground="{StaticResource Text2}" FontSize="12.5" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="InstallBtn" Grid.Row="2" Style="{StaticResource Primary}" Click="Install_Click" IsDefault="True"/>
            </Grid>

            <!-- step 2: installing -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="40,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="Installing" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Height="5" Margin="0,18,0,0" BorderThickness="0"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Line}"/>
                <TextBlock x:Name="InstallingHint" Foreground="{StaticResource Text2}" FontSize="12.5" HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>

            <!-- step 3: done -->
            <Grid x:Name="DonePanel" Grid.Row="1" Margin="22,20,22,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#E7F6EC" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="#1E7B3C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DoneTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DoneBody" Foreground="{StaticResource Text2}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="10,6,10,0"/>
                </StackPanel>
                <Button x:Name="OpenBtn" Grid.Row="1" Style="{StaticResource Primary}" Click="Open_Click" IsDefault="True"/>
                <Button x:Name="DoneCloseBtn" Grid.Row="2" Style="{StaticResource Quiet}" Click="Close_Click" Margin="0,6,0,-8"
                        HorizontalAlignment="Center"/>
            </Grid>

            <!-- failed -->
            <Grid x:Name="ErrorPanel" Grid.Row="1" Margin="22,20,22,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               HorizontalAlignment="Center"/>
                    <Border Background="#FDECEC" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                        <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <Button x:Name="RetryBtn" Grid.Row="1" Style="{StaticResource Primary}" Click="Retry_Click"/>
            </Grid>

            <TextBlock x:Name="VersionText" Grid.Row="2" Foreground="#9AA1AD" FontSize="12" HorizontalAlignment="Center"
                       Margin="0,14,0,16"/>
        </Grid>
    </Border>
</Window>
