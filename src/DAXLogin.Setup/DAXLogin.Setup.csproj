<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Styled front end for the Velopack installer. The Velopack Setup.exe built by `vpk pack`
    is embedded as a resource and run silently, so install layout, uninstall entry and
    updates stay exactly what Velopack expects.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>DAXLogin-Setup</AssemblyName>
    <RootNamespace>DAXLogin.Setup</RootNamespace>
    <ApplicationIcon>..\DAXLogin\Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>DAXLogin Setup</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PayloadPath Condition="'$(PayloadPath)' == ''">$(MSBuildThisFileDirectory)..\..\Releases\DAXLogin-win-Setup.exe</PayloadPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\DAXLogin\Assets\app.ico" Link="Assets\app.ico" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.exe" Link="payload.exe" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadPath)')"
           Text="Installer payload not found at $(PayloadPath). Run build\pack.ps1, which runs vpk pack first." />
  </Target>

</Project>
