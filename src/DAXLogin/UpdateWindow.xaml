<Window x:Class="DAXLogin.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DAXLogin"
        Title="{s:L UpdateTitle}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico" Style="{StaticResource Win}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Current" Style="{StaticResource Hint}" Margin="0,2,0,0"/>

        <StackPanel x:Name="NotesPanel" Visibility="Collapsed">
            <TextBlock Text="{s:L WhatsNew}" Style="{StaticResource FieldLabel}"/>
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Notes" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}"
                         Background="{StaticResource Line}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock x:Name="Msg" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterBtn" Style="{StaticResource Btn}" Content="{s:L Later}" IsCancel="True" Click="Later_Click"/>
            <Button x:Name="InstallBtn" Style="{StaticResource BtnPrimary}" Content="{s:L InstallRestart}" IsDefault="True"
                    Margin="8,0,0,0" Click="Install_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
