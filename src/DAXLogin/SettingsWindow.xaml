<Window x:Class="DAXLogin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DAXLogin"
        Title="{s:L Settings}" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource Win}">
    <StackPanel Margin="16,6,16,16">
        <TextBlock Text="{s:L Ax32Path}" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AxBox"/>
            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Content="&#xE838;" Margin="8,0,0,0"
                    Click="Browse_Click" ToolTip="{s:L Browse}" AutomationProperties.Name="{s:L Browse}"/>
        </Grid>

        <CheckBox x:Name="AutoLaunchBox" Content="{s:L AutoLaunch}" Margin="0,14,0,0"/>
        <TextBlock Text="{s:L AutoLaunchHint}" Style="{StaticResource Hint}" Margin="20,2,0,0"/>
        <CheckBox x:Name="TrayBox" Content="{s:L MinToTray}"/>
        <CheckBox x:Name="StartupBox" Content="{s:L StartWithWindows}"/>
        <CheckBox x:Name="UpdateBox" Content="{s:L AutoUpdate}"/>

        <TextBlock Text="{s:L Language}" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="LangBox" Width="160" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center">
            <ComboBoxItem Content="ไทย" Tag="th"/>
            <ComboBoxItem Content="English" Tag="en"/>
        </ComboBox>

        <TextBlock x:Name="Msg" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,16,0,0">
            <Button x:Name="CheckBtn" Style="{StaticResource Btn}" Content="{s:L CheckUpdate}" HorizontalAlignment="Left"
                    Click="Check_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="{s:L Cancel}" IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{s:L Save}" IsDefault="True" Margin="8,0,0,0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
