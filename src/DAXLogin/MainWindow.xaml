<Window x:Class="DAXLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DAXLogin"
        Title="DAXLogin" Width="430" Height="540" MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Style="{StaticResource Win}">
    <Window.Resources>
        <Style x:Key="RowOpen" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="30,0,8,0"
                     AutomationProperties.Name="{s:L SearchHint}"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Text2}"
                       Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="{s:L SearchHint}" Foreground="{StaticResource Text2}"
                       Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Content="&#xE710;" Margin="8,0,0,0"
                    Click="Add_Click" ToolTip="{s:L AddProfile}" AutomationProperties.Name="{s:L AddProfile}"/>
            <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Content="&#xE72D;" Margin="8,0,0,0"
                    Click="Share_Click" ToolTip="{s:L Share}" AutomationProperties.Name="{s:L Share}"/>
            <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Content="&#xE713;" Margin="8,0,0,0"
                    Click="Settings_Click" ToolTip="{s:L Settings}" AutomationProperties.Name="{s:L Settings}"/>
        </Grid>

        <Border Grid.Row="1" Margin="12,0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="List_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}"
                                                BorderThickness="0,0,0,1" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}">
                                    <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="{StaticResource SuccessBg}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{s:L Default}" FontSize="11" Foreground="{StaticResource SuccessText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Account}" Foreground="{StaticResource Text2}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource RowOpen}" Click="Open_Click" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                                        <TextBlock Text="{s:L OpenAx}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource BtnGhostIcon}" Content="&#xE712;" Margin="4,0,0,0"
                                        Click="More_Click" ToolTip="{s:L More}" AutomationProperties.Name="{s:L More}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                    <TextBlock Text="{s:L EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:L EmptyBody}" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                               Margin="0,6,0,14" MaxWidth="280"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{s:L AddProfile}" Click="Add_Click"
                            HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="NoMatch" Text="{s:L NoMatch}" Style="{StaticResource Hint}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,8,14,10">
            <TextBlock x:Name="HintText" Text="{s:L FooterHint}" Style="{StaticResource Hint}"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Foreground="{StaticResource SuccessText}"
                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
