<Window x:Class="DAXLogin.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DAXLogin"
        Title="{s:L Export}" Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource Win}">
    <StackPanel Margin="16,10,16,16">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="12,4,12,12">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="IncludePw" Content="{s:L IncludePasswords}" IsChecked="True" Margin="0,12,0,0"/>

        <TextBlock Text="{s:L FilePass}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Pass1"/>
        <TextBlock Text="{s:L FilePassConfirm}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Pass2"/>
        <TextBlock Text="{s:L FilePassHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

        <TextBlock x:Name="Msg" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

        <Grid Margin="0,16,0,0">
            <Button Style="{StaticResource Btn}" Content="{s:L Import}" HorizontalAlignment="Left" Click="Import_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="{s:L Cancel}" IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{s:L DoExport}" IsDefault="True" Margin="8,0,0,0"
                        Click="Export_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
